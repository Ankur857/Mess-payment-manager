{
  "expo": {
    "name": "Raghuvanshi Restorent & Cafe",
    "slug": "raghuvanshi-cafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "feemanager",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.feemanager.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Raghuvanshi Restorent & Cafe to access your camera to capture student profile photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Raghuvanshi Restorent & Cafe to access your photo library to choose student profile photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}